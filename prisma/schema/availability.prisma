model Availability {
  id           String @id @default(uuid())
  technicianId String

  day       WeekDay
  startTime String
  endTime   String

  isAvailable Boolean @default(true)

  technician User @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
